# Copy to .env and fill in:  cp env.template .env
# Keep this file free of real values; .env is gitignored.

# --- required -------------------------------------------------------------

# Hostname traefik routes to, e.g. braincogs01-test0.pni.princeton.edu
SERVICEHOSTNAME=

# Container name prefix, e.g. u19_data_viewer_test
COMPOSE_PROJECT_NAME=

# CAS single sign-on, e.g. https://fed.princeton.edu/cas/login
CASLOGINURL=
# e.g. https://fed.princeton.edu/cas/serviceValidate
CASVALIDATEURL=

# --- external blob store --------------------------------------------------

# Host path of the u19_dj share; set only if the host mounts it elsewhere.
# Without a working mount the subject photos show "No image".
U19_DJ_HOST_PATH=/mnt/u19_dj

# --- optional -------------------------------------------------------------

# Extra websocket origins when the published port differs from 5000,
# e.g. localhost:5001,127.0.0.1:5001
EXTRA_WS_ORIGINS=

# Re-roots the datajoint store paths from dj_local_conf.json onto the
# container's mount. Defaults to /mnt/u19_dj.
DJ_STORE_ROOT=
# Old prefix to strip; inferred from the store paths when unset.
DJ_STORE_ROOT_REPLACES=

# Bokeh session token lifetime in seconds. Defaults to 3600.
SESSION_TOKEN_EXPIRATION=

# Set to 1 to build all tabs in the background. Single-user deployments only:
# concurrent sessions queue behind each other.
PREWARM_TABS=

# --- database credentials -------------------------------------------------

# Unused: datajoint reads its connection details from dj_local_conf.json.
DJ_HOST=
DJ_USER=
DJ_PASS=

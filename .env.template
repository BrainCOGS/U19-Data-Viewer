# Host path of the u19_dj NFS share, bind-mounted read-only at /mnt/u19_dj in
# the container. Defaults to /mnt/u19_dj, which suits a Linux host; on macOS the
# share appears under /Volumes, so set U19_DJ_HOST_PATH=/Volumes/u19_dj.
# Without it the subject photo panels show "No image".
U19_DJ_HOST_PATH=/mnt/u19_dj

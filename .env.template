# Copy to .env and fill in. .env is gitignored because it carries a password;
# this template is tracked, so keep it free of real values.
#
#   cp .env.template .env
#
# Note: .gitignore ignores .env*, so if this file ever needs re-adding, use
#   git add -f .env.template

# --- required by docker-compose -------------------------------------------

# Hostname traefik routes to, and the ServerName apache serves
# (apache/sites/proxypass.conf). e.g. braincogs01-test0.pni.princeton.edu
SERVICEHOSTNAME=

# Prefixes the container names, so several deployments can share one host.
# e.g. u19_data_viewer_test
COMPOSE_PROJECT_NAME=

# --- CAS single sign-on, read by apache/sites/cas.conf ---------------------

# e.g. https://fed.princeton.edu/cas/login
CASLOGINURL=
# e.g. https://fed.princeton.edu/cas/serviceValidate
CASVALIDATEURL=

# --- external blob store --------------------------------------------------

# Host path of the u19_dj share, bind-mounted read-only at /mnt/u19_dj in the
# container. Only set this if the host keeps the share somewhere other than
# /mnt/u19_dj. Without a working mount the subject photo panels fall back to
# "No image".
U19_DJ_HOST_PATH=/mnt/u19_dj

# --- optional ------------------------------------------------------------

# Extra websocket origins, comma separated, for when the published host port
# differs from the 5000 the server listens on: the browser's Origin carries the
# host port and is otherwise refused. e.g. localhost:5001,127.0.0.1:5001
EXTRA_WS_ORIGINS=

# Re-roots the datajoint external stores onto the container's mount point, for
# when dj_local_conf.json holds store paths from a different machine. Defaults
# to /mnt/u19_dj. DJ_STORE_ROOT_REPLACES is the old prefix to strip, and only
# needs setting when that config uses something unexpected.
DJ_STORE_ROOT=
DJ_STORE_ROOT_REPLACES=

# Seconds a bokeh session token stays valid. The default of 3600 replaces
# bokeh's own 300, which a slow first render could exceed, leaving a blank page
# and "Token is expired" in the log.
SESSION_TOKEN_EXPIRATION=

# Set to 1 to build every tab in the background after the first one paints.
# Off by default: each session runs its own chain on a shared IO loop, so with
# several sessions the loads queue behind each other. Single-user only.
PREWARM_TABS=

# --- database credentials -------------------------------------------------

# NOTE: nothing reads these. DataJoint takes its connection details from
# dj_local_conf.json (also gitignored), which is what you actually need to
# configure. They are listed because the README asks for them, and are kept in
# case a future entrypoint wires them up.
DJ_HOST=
DJ_USER=
DJ_PASS=
